# =============================================================================
# DataForge Studio — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment ("development" | "staging" | "production")
# In production: OpenAPI docs are disabled and stricter defaults apply.
# -----------------------------------------------------------------------------
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# API Configuration
# Generate a secure key with: openssl rand -hex 32
# -----------------------------------------------------------------------------
API_KEY=your-secure-api-key-here
API_PREFIX=/v1
API_TITLE=DataForge Studio API
API_VERSION=0.1.0

# -----------------------------------------------------------------------------
# JWT Authentication (optional — recommended for production)
# Set ENABLE_JWT_AUTH=true and generate a secret: openssl rand -hex 32
# -----------------------------------------------------------------------------
ENABLE_JWT_AUTH=false
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# Rate Limiting (requires slowapi — set true in production)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_GENERATION=10/minute

# -----------------------------------------------------------------------------
# CORS — restrict to your actual frontend origin(s) in production
# Example: CORS_ORIGINS=["https://app.yourdomain.com"]
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# -----------------------------------------------------------------------------
# AWS Configuration
# For local dev, use an IAM user with Bedrock access.
# In production, prefer IAM roles (leave keys blank and use instance profile).
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS Bedrock AgentCore (optional - advanced production mode)
BEDROCK_AGENT_ID=your-agent-id
BEDROCK_AGENT_ALIAS_ID=your-agent-alias-id

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
LLM_PROVIDER=bedrock
# Claude Haiku 4.5 via cross-region inference profile (cost-optimised):
LLM_MODEL=arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_STREAMING=true

# -----------------------------------------------------------------------------
# LangSmith (agent tracing & evaluation — optional)
# -----------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=dataforge-studio
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# -----------------------------------------------------------------------------
# Storage
# Set USE_S3=true and configure S3_BUCKET in production.
# -----------------------------------------------------------------------------
LOCAL_ARTIFACTS_DIR=artifacts
USE_S3=false
S3_BUCKET=your-dataforge-artifacts-bucket
S3_REGION=us-east-1
S3_PREFIX=artifacts

# -----------------------------------------------------------------------------
# Redis (job state & caching)
# Set USE_REDIS=true in production.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL=3600
USE_REDIS=false

# -----------------------------------------------------------------------------
# Generation limits
# -----------------------------------------------------------------------------
MAX_ROWS_PER_TABLE=1000000
MAX_TABLES=50
MAX_COLUMNS_PER_TABLE=200
MAX_CONCURRENT_JOBS=10
JOB_TIMEOUT_SECONDS=3600

# -----------------------------------------------------------------------------
# PII detection
# -----------------------------------------------------------------------------
SPACY_MODEL=en_core_web_sm
PII_DETECTION_ENABLED=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
